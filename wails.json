{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "langratia-pharmacy-pos",
  "outputfilename": "LangratiaPharmacyPOS",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "allaninfo-comp",
    "email": "allan.info.comp@gmail.com"
  },
  "windows": {
    "webview2": "fixed",
    "webview2version": "126.0.2592.113",
    "nsis": {
      "name": "Langratia Pharmacy POS",
      "displayName": "Langratia Pharmacy Point of Sale",
      "publisher": "Langratia Systems",
      "description": "Enterprise Pharmacy Management & POS System",
      "installMode": "perMachine",
      "installerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "includeDesktopShortcut": true,
      "includeStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Langratia Pharmacy POS"
    }
  }
}
